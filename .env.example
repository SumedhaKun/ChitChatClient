# Local dev (default when running npm run dev)
NEXT_PUBLIC_DELIVERY_SERVICE_URL=ws://localhost:8082
NEXT_PUBLIC_USER_SERVICE_URL=http://localhost:8081
NEXT_PUBLIC_MESSAGE_SERVICE_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Production (set explicitly; the WebSocket client does not infer this from the app host)
# NEXT_PUBLIC_DELIVERY_SERVICE_URL=wss://your-delivery-service.onrender.com
# NEXT_PUBLIC_USER_SERVICE_URL=https://users.example.com
# NEXT_PUBLIC_MESSAGE_SERVICE_URL=https://messages.example.com
